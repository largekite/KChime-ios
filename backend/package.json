{
  "name": "kchime-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KChime API — reply generation, auth, usage, payments",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && node node_modules/esbuild/bin/esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "build:vercel": "tsc --noEmit && node node_modules/esbuild/bin/esbuild api/index.ts --bundle --platform=node --target=node20 --outfile=api/index.js",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "hono": "^4.4.0",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.26.0",
    "jose": "^5.6.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
