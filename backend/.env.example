# Copy this to .env and fill in the values

# AI — at least one is required (Anthropic recommended, OpenAI is fallback)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Vercel Postgres / Neon connection string (required for usage tracking + auth)
# Create a free Neon project at https://neon.tech or use Vercel Postgres
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# JWT secret — any long random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-string

# Apple Sign-in (only needed for auth — not required for basic reply generation)
APPLE_CLIENT_ID=com.kchime.app

# RevenueCat webhook secret (only needed for payments webhook)
# REVENUECAT_WEBHOOK_SECRET=
