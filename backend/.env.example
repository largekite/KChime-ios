# Copy this to .env and fill in the values

# AI — at least one is required (Anthropic recommended, OpenAI is fallback)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Supabase — Project Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) for serverless/local dev
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT secret — any long random string
# Generate one: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-string

# Apple Sign-in (only needed for auth — not required for basic reply generation)
APPLE_CLIENT_ID=com.kchime.app

# RevenueCat webhook secret (only needed for payments webhook)
# REVENUECAT_WEBHOOK_SECRET=
