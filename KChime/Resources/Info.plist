<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>KChime</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 KChime. All rights reserved.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Allows http://localhost during development; does NOT open up non-local HTTP -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSFaceIDUsageDescription</key>
    <string>KChime uses Face ID to protect your saved contact notes.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>KChime uses the microphone to transcribe messages so you can get instant reply suggestions hands-free.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>KChime uses speech recognition to convert your spoken messages to text in real time.</string>
</dict>
</plist>
