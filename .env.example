# ─── KChime Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env (never commit .env) and fill in the values.
# Production secrets go in Vercel Dashboard → Settings → Environment Variables.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# CORS — comma-separated origins allowed in production
# ALLOWED_ORIGINS=https://kchime.vercel.app

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign/verify KChime session JWTs (min 32 chars, random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Sign in with Apple — must match the iOS bundle ID (com.kchime.app)
APPLE_CLIENT_ID=com.kchime.app

# Apple Team ID (10-character string from developer.apple.com)
APPLE_TEAM_ID=XXXXXXXXXX

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At least one must be set. OpenAI is used first; Anthropic is the fallback.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres connection string (injected automatically on Vercel)
POSTGRES_URL=postgres://user:password@host:5432/kchime

# For AWS Lambda, use a Neon pooled connection string instead:
# DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Payments — RevenueCat ────────────────────────────────────────────────────
# API key from RevenueCat Dashboard → Project → API Keys (use server-side key)
REVENUECAT_API_KEY=sk_...

# Webhook authorization secret — set in RevenueCat Dashboard → Integrations → Webhooks
REVENUECAT_WEBHOOK_SECRET=a-random-secret-string

# ─── Rate limiting (optional) ─────────────────────────────────────────────────
# Upstash Redis REST URL/token for distributed rate limiting (multi-region)
# If unset, falls back to in-process memory (single instance only)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
